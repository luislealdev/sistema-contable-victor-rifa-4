generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    username  String   @unique
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Section {
    id      Int      @id @default(autoincrement())
    name    String
    clients Client[]
}

model Client {
    id        Int      @id @default(autoincrement())
    name      String
    phone     String
    address   String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    section   Section? @relation(fields: [sectionId], references: [id])
    sectionId Int?

    transactions Transaction[]
    payments     Payment[]
    RaffleTicket RaffleTicket[]
}

model Transaction {
    id          Int             @id @default(autoincrement())
    type        TransactionType // 'SALE', 'LOAN', 'SERVICE'
    isActive    Boolean         @default(true)
    description String?
    totalAmount Float
    // remaining   Float // Delete
    createdAt   DateTime        @default(now())

    client   Client @relation(fields: [clientId], references: [id])
    clientId Int

    // payments Payment[]
}

model Payment {
    id          Int      @id @default(autoincrement())
    amount      Float
    date        DateTime @default(now())
    description String?
    // transaction   Transaction? @relation(fields: [transactionId], references: [id])
    // transactionId Int?

    client   Client @relation(fields: [clientId], references: [id])
    clientId Int
}

enum TransactionType {
    SALE
    LOAN
    SERVICE
}

model Raffle {
    id           Int      @id @default(autoincrement())
    title        String
    drawDate     DateTime
    ticketPrice  Float
    totalNumbers Int
    prize        String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    tickets   RaffleTicket[]
    PreRaffle PreRaffle[]
}

model RaffleTicket {
    id        Int     @id @default(autoincrement())
    number    Int
    totalPaid Float   @default(0.0)
    isPaid    Boolean @default(false)

    client      Client  @relation(fields: [clientId], references: [id])
    clientId    Int
    clientAlias String?

    raffle   Raffle @relation(fields: [raffleId], references: [id])
    raffleId Int

    createdAt DateTime              @default(now())
    payments  RaffleTicketPayment[]

    @@unique([raffleId, number]) // Un número por rifa, sin duplicados
}

model RaffleTicketPayment {
    id     Int      @id @default(autoincrement())
    amount Float
    date   DateTime @default(now())

    ticket   RaffleTicket @relation(fields: [ticketId], references: [id])
    ticketId Int
}

model PreRaffle {
    id        Int      @id @default(autoincrement())
    title     String
    drawDate  DateTime
    raffle    Raffle   @relation(fields: [raffleId], references: [id])
    raffleId  Int
    prize     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Order {
    id             Int         @id @default(autoincrement())
    client         String
    gender         String?
    number         String?
    product        String?
    specifications String?
    totalAmount    Float?
    OrderItem      OrderItem[]
    createdAt      DateTime?   @default(now())
}

model OrderItem {
    id      Int     @id @default(autoincrement())
    gender  String?
    number  String?
    order   Order   @relation(fields: [orderId], references: [id])
    orderId Int
}

model AuditLog {
    id        Int      @id @default(autoincrement())
    action    String   // CREATE, UPDATE, DELETE
    entity    String   // Order, Client, Transaction, etc.
    entityId  Int      // ID del registro afectado
    oldValues String?  // JSON con valores anteriores (para UPDATE/DELETE)
    newValues String?  // JSON con valores nuevos (para CREATE/UPDATE)
    info      String?  // Información adicional o descripción
    timestamp DateTime @default(now())
    userId    Int
    
    // Opcional: relación con User si tienes modelo User
    // user      User     @relation(fields: [userId], references: [id])
}
